# --- inputs (edit the three literals below; the language has no str-valued
# function parameters, so the request runs off module globals) ---
http_method: str[8] = "GET"
http_url: str[256] = "http://127.0.0.1:8080/"
http_body: str[2048] = ""

# --- outputs (read after this file runs) ---
http_status: int[64] = 0
http_out: str[4096] = ""
http_digits: str[11] = "0123456789"
http_tail: str[24] = " HTTP/1.1\r\nHost: "
http_cl: str[20] = "Content-Length: "
http_ct: str[33] = "Content-Type: application/json\r\n"

# --- run: module-level scalars ---
done: int[64] = 0
status: int[64] = 0
fd: int[64] = -1
n: int[64] = 0
scheme_ok: int[64] = 1
host_start: int[64] = 7
host_end: int[64] = len(http_url)
port: int[64] = 80
path_start: int[64] = -1
port_start: int[64] = -1
port_end: int[64] = len(http_url)
ip: int[64] = 0
host_len: int[64] = host_end - host_start
out: int[64] = 0
body_len: int[64] = 0
sp: int[64] = 0
remain: int[64] = 0
sent: int[64] = 0
total: int[64] = 0
bs: int[64] = 0
body_start: int[64] = -1
dst: int[64] = 0
pos: int[64] = 0
exp: int[64] = 0
bytev: int[8] = 0
d1: int[64] = 0
d2: int[64] = 0
d3: int[64] = 0
digit_ok: int[64] = 0
oa: int[64] = 0
ob: int[64] = 0
lb: list[int[8], 64]
bl: list[int[8], 4096]
req: str[4096]
sa: Sa
_psa: ptr[Sa] = addressof(sa)
ch: Chunker
_pch: ptr[Chunker] = addressof(ch)
