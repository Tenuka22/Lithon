# HTTP client — part 1/5 (00_common):
# constants, swap helpers, kernel-visible Chunker, globals
#
# There is no import system in Lithon: prepend this file to your program
# (or paste it in). It depends on nothing but the `syscall()` builtin,
# `str[N]` buffers, and the loops the language already has. Usage:
#
#     http_method = "POST"
#     http_url = "http://127.0.0.1:8080/api/items"
#     http_body = '{"sku": 7}'
#     s: int[64] = http_request()
#     print(s)          # 201
#     print(http_out)   # response body, e.g. '{"created": true}'
#
# Supported verbs are the method literal alone: GET / PUT / PATCH / POST /
# DELETE all run the same code path. The body is opaque text — JSON and HTML
# need no distinction, only how you read http_out. Status is the HTTP code,
# or 0 when the request could not be made at all (bad URL, refused connect,
# empty/unexpected response); http_out is then "" (or the partial body).
#
# Limits (all deliberate, all safe):
#   - Plain HTTP only. There is no TLS stack; https:// never connects.
#     (Upgrade when a TLS implementation lands in the syscall layer.)
#   - IPv4 literals and "localhost" only. No DNS resolver exists.
#   - IPv4-only sockaddr_in, Linux/x86-64 syscall numbers (41/42/44/45/3).
#   - One send, one recv of at most 8191 bytes: a response larger than one
#     blocking read is truncated. Chunked encoding bodies keep their size
#     lines embedded. (Upgrade when ptr arithmetic / transfer loops land.)
#   - Fixed request headers: Host, Connection: close, and Content-Length +
#     Content-Type: application/json when a body is present. No custom
#     headers, no redirects, no timeouts, no keep-alive (new socket per call).
#

def swap32(v: int[64]) -> int[64]:
    return ((v & 255) << 24) | ((v & 65280) << 8) | ((v >> 8) & 65280) | ((v >> 24) & 255)


def swap16(v: int[64]) -> int[64]:
    return ((v & 255) << 8) | ((v >> 8) & 255)


class Sa(struct):
    lo: int[64]
    hi: int[64]

class Chunker(struct):
    f0: int[8]
    f1: int[8]
    f2: int[8]
    f3: int[8]
    f4: int[8]
    f5: int[8]
    f6: int[8]
    f7: int[8]
    f8: int[8]
    f9: int[8]
    f10: int[8]
    f11: int[8]
    f12: int[8]
    f13: int[8]
    f14: int[8]
    f15: int[8]
    f16: int[8]
    f17: int[8]
    f18: int[8]
    f19: int[8]
    f20: int[8]
    f21: int[8]
    f22: int[8]
    f23: int[8]
    f24: int[8]
    f25: int[8]
    f26: int[8]
    f27: int[8]
    f28: int[8]
    f29: int[8]
    f30: int[8]
    f31: int[8]
    f32: int[8]
