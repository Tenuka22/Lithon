        remain = out - sp
        if remain > 64:
            remain = 64
        sent = syscall(44, fd, _pch, remain, 0, 0, 0)
        if sent <= 0:
            syscall(3, fd)
            done = 1
        sp = sp + remain


# --- receive: chunked recv with a streaming status/boundary/body parse ---
# Bytes arrive 64 at a time in ch.* (kernel-real in both tiers). Each chunk
# is copied into lb so the state machine can walk it with dynamic indices.
lb: list[int[8], 64]
