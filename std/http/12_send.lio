# part file 12_send.lio of std/http/ (concatenate in order)
# socket + connect + chunked send
    sa.lo = 2 | (swap16(port) << 16) | (swap32(ip) << 32)
    sa.hi = 0
    fd = syscall(41, 2, 1, 0)
    if fd < 0:
        done = 1
if done == 0:
    if syscall(42, fd, _psa, 16) < 0:
        syscall(3, fd)
        done = 1

if done == 0:
    sp = 0
    while sp < out and done == 0:
        if sp + 0 < out:
            ch.f0 = req[sp]
        if sp + 1 < out:
