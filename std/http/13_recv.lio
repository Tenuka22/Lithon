                if cpy == 62:
                    lb[62] = ch.f62
                if cpy == 63:
                    lb[63] = ch.f63
                cpy = cpy + 1
            i = 0
            while i < n:
                pos = total + i
                byte: int[8] = lb[i]
                if pos == 9:
                    d1 = byte
                if pos == 10:
                    d2 = byte
                if pos == 11:
                    d3 = byte
                if body_start < 0:
                    exp: int[64] = 13
                    if bs == 1 or bs == 3:
                        exp = 10
                    if byte == exp:
                        bs = bs + 1
                        if bs == 4:
                            body_start = pos + 1
                    else:
                        if byte == 13:
                            bs = 1
                        else:
                            bs = 0
                else:
                    if dst < 4095:
                        http_out[dst] = byte
                        dst = dst + 1
                i = i + 1
            total = total + n
    syscall(3, fd)

if status == 0:
    digit_ok = 0
    if d1 >= 48 and d1 <= 57:
        digit_ok = digit_ok + 1
    if d2 >= 48 and d2 <= 57:
        digit_ok = digit_ok + 1
    if d3 >= 48 and d3 <= 57:
        digit_ok = digit_ok + 1
    if digit_ok == 3:
        status = (d1 - 48) * 100 + (d2 - 48) * 10 + (d3 - 48)

http_status = status
print(status)
print(http_out)
