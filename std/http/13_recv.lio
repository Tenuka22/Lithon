# part file 13_recv.lio of std/http/ (concatenate in order)
# chunked recv + streaming status/boundary/body parse
total = 0
bs: int[64] = 0
body_start: int[64] = -1
dst: int[64] = 0
pos: int[64] = 0
chunk_i: int[64] = 0

if done == 0:
    while total < 8192 and done == 0:
        chunk_i = 0
        n = syscall(45, fd, _pch, 64, 0, 0, 0)
        if n <= 0:
            done = 2
        if n > 0:
            cpy: int[64] = 0
            while cpy < n:
                if cpy == 0:
                    lb[0] = ch.f0
                if cpy == 1:
                    lb[1] = ch.f1
                if cpy == 2:
                    lb[2] = ch.f2
                if cpy == 3:
                    lb[3] = ch.f3
